<?xml version='1.0' encoding='utf-8'?>

<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:em="http://www.mozilla.org/2004/em-rdf#">
	<Description about="urn:mozilla:install-manifest">
		<em:id>classicsidebar@pb</em:id>
		<em:version>1.1.9</em:version>
		<em:type>2</em:type>
		<em:name>Classic Sidebar</em:name>
		<em:description>Restores the multi-panel sidebar from Netscape Navigator 7.0, Mozilla and SeaMonkey.</em:description>
		<em:creator>길고 (Port), The Netscape Navigator Contributors (Original)</em:creator>

		<em:localized>
			<Description>
				<em:locale>ko</em:locale>
				<em:name>다중 패널 사이드바</em:name>
				<em:description>씨몽키, 모질라, 넷스케이프 7.0의 다중 패널 사이드바</em:description>
				<em:translator>길고</em:translator>
			</Description>
		</em:localized>

		<em:targetApplication>
			<Description>
				<em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
				<em:minVersion>26.0.0</em:minVersion>
				<em:maxVersion>35.*</em:maxVersion>
			</Description>
		</em:targetApplication>
	</Description>
</RDF>
